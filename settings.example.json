{
  "provider": "openai",
  "baseUrl": "https://api.moonshot.cn/v1",
  "apiKey": "KIMI_API_KEY",
  "model": "kimi-k2.6",
  "confirmEdits": true,
  "confirmBash": true,
  "readOnly": false,
  "streamOutput": true,
  "autoCompact": false,
